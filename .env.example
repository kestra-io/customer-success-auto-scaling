# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cluster / Helm ───────────────────────────────────────────────────────────
KIND_CLUSTER_NAME=kestra-autoscaling
K8S_NAMESPACE=autoscaling
HELM_RELEASE=kestra
# kestra-kubectl skill uses helm.kestra.io; an older repo file used charts.kestra.io.
HELM_REPO_URL=https://helm.kestra.io/
# Sept 2027: pinned to the latest: 1.3.37 
# Run: `helm search repo kestra/kestra --version` for available versions  
# (leave blank = latest chart)
HELM_CHART_VERSION=1.3.37

# ── Kestra image ─────────────────────────────────────────────────────────────
# Enterprise (default). For OSS with no license, use: kestra/kestra:v1.3.37
KESTRA_IMAGE=registry.kestra.io/docker/kestra-ee:v1.3.37

# ── Registry + EE license (leave blank when KESTRA_IMAGE is the OSS image) ────
KESTRA_REGISTRY_SERVER=registry.kestra.io
KESTRA_REGISTRY_USERNAME=          # same as LICENSE ID
KESTRA_REGISTRY_PASSWORD=          # same as LICENSE FINGERPRINT
KESTRA_EE_LICENSE_ID=
KESTRA_EE_LICENSE_FINGERPRINT=
KESTRA_EE_LICENSE_KEY=

# ── Kestra internal secrets ─────────────────────────────────────────────────
# JDBC + ENCRYPTION keys MUST be exactly 32 characters (used as raw AES-256 keys).
KESTRA_JDBC_SECRET=change-me-32-characters-abcdefgh
KESTRA_ENCRYPTION_SECRET_KEY=change-me-32-characters-klmnopqr
KESTRA_JWT_SECRET=change-me-jwt-generator-secret-uvwxyz

# ── Kestra admin login ─────────────────────────────────────────────────────
KESTRA_ADMIN_USER=admin@example.com
KESTRA_ADMIN_PASSWORD=Autoscaling123

# ── In-cluster Postgres ──────────────────────────────────────────────────────
POSTGRES_DB=kestra
POSTGRES_USER=kestra
POSTGRES_PASSWORD=kestraPostgres123

# ── Flow ─────────────────────────────────────────────────────────────────────
KESTRA_TENANT=main
FLOW_NAMESPACE=company.autoscaling
FLOW_ID=webhook_sleep
WEBHOOK_KEY=demo-key
SLEEP_DURATION=PT15S

# ── Worker sizing (must match helm/values.yaml) ──────────────────────────────
WORKER_REPLICAS=1
WORKER_THREADS=4

# ── Trigger app ─────────────────────────────────────────────────────────────
# Rates are triggers/minute. Baseline is tuned for ~50% of one 4-thread worker.
RATE_BASELINE=8
RATE_SPIKE=24
RATE_DROP=2
RATE_MAX=30
APP_PORT=5173

# ── Prometheus metric names ─────────────────────────────────────────────────
# Verified/overwritten at bring-up by scripts/verify-metrics.sh -> .state/metric-names.env
METRIC_PENDING=kestra_worker_job_pending
METRIC_RUNNING=kestra_worker_job_running
METRIC_THREADS=kestra_worker_job_thread

# ── Workstream 1 scaler knobs ───────────────────────────────────────────────
POLL_INTERVAL_SECONDS=15
SCALE_UP_WINDOW_SECONDS=60
SCALE_DOWN_WINDOW_SECONDS=180
PENDING_SCALE_UP_THRESHOLD=1
RUNNING_SCALE_DOWN_RATIO=0.5
SCALE_STEP=1
MIN_REPLICAS=1
MAX_REPLICAS=2
COOLDOWN_SECONDS=90
SCALER_DRY_RUN=false
SCALER_LOG_LEVEL=INFO
