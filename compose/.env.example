# Copy to .env in this directory:  cp .env.example .env

# Enterprise (default). For OSS with no license, use:  kestra/kestra:v1.3.24
KESTRA_IMAGE=registry.kestra.io/docker/kestra-ee:v1.3.24

# Leave blank when using the OSS image.
KESTRA_EE_LICENSE_ID=
KESTRA_EE_LICENSE_FINGERPRINT=
KESTRA_EE_LICENSE_KEY=

POSTGRES_DB=kestra
POSTGRES_USER=kestra
POSTGRES_PASSWORD=kestraPostgres123

WORKER_THREADS=4
RATE_BASELINE=8
RATE_SPIKE=24
RATE_DROP=2
RATE_MAX=30
APP_PORT=5173
